{
  "name": "yahoo-fantasy-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint extension tests scripts eslint.config.js",
    "test": "node --test \"tests/*.test.js\"",
    "check": "npm run lint && npm test",
    "userscript": "node scripts/userscript.js",
    "serve": "node scripts/userscript.js --serve",
    "publish:friends": "npm run check && node scripts/userscript.js --publish"
  },
  "dependencies": {
    "playwright-core": "^1.49.0"
  },
  "devDependencies": {
    "eslint": "^10.12.0",
    "globals": "^17.13.0"
  }
}
